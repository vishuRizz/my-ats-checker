{
  "name": "ats-checker-backend",
  "version": "1.0.0",
  "description": "ATS Checker Backend - Fastify API for resume parsing and analysis",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "fastify": "^4.28.1",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.6.82",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
