# ─── Server ───────────────────────────────────────────────────
PORT=
HOST=
NODE_ENV=
LOG_LEVEL=

# ─── Anonymous request limits ─────────────────────────────────
ANALYZE_LIMIT_PER_HOUR=10
SUGGEST_LIMIT_PER_HOUR=5

# ─── CORS (set to your Vercel frontend URL in production) ─────
CORS_ORIGIN=

# ─── Database (Neon PostgreSQL) ───────────────────────────────
DATABASE_URL=

# ─── Groq API Keys (round-robin rotation) ────────────────────
GROQ_KEY_1=
GROQ_KEY_2=
GROQ_KEY_3=
GROQ_KEY_4=

# ─── Gemini API Keys (fallback / rotation) ────────────────────
GEMINI_KEY_1=
GEMINI_KEY_2=
